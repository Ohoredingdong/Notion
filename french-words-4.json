[{"word":"ici","ipa":"/i.si/","meaning":"여기","nuance":"화자 가까이에 있는 장소를 가리킵니다.","examples":[["Je travaille ici.","저는 여기서 일해요."],["Asseyez-vous ici.","여기 앉으세요."],["Il y a un café ici.","여기에 카페가 있어요."],["Attendez-moi ici.","여기서 저를 기다려 주세요."]]},{"word":"là-bas","ipa":"/la.ba/","meaning":"저기, 저쪽","nuance":"화자에게서 떨어진 장소를 가리킵니다.","examples":[["La gare est là-bas.","역은 저쪽에 있어요."],["Je vais là-bas demain.","저는 내일 저쪽에 가요."],["Regarde là-bas !","저쪽을 봐요!"],["Mes amis habitent là-bas.","제 친구들은 저쪽에 살아요."]]},{"word":"près","ipa":"/pʁɛ/","meaning":"가까이","nuance":"거리상 가까움을 나타냅니다.","examples":[["J'habite près de la gare.","저는 역 근처에 살아요."],["Le café est tout près.","카페가 아주 가까워요."],["Reste près de moi.","제 가까이에 있어요."],["Nous travaillons près du centre.","우리는 중심가 근처에서 일해요."]]},{"word":"loin","ipa":"/lwɛ̃/","meaning":"멀리","nuance":"거리상 멂을 나타냅니다.","examples":[["Ce n'est pas loin.","멀지 않아요."],["Il habite loin d'ici.","그는 여기서 멀리 살아요."],["La gare est assez loin.","역은 꽤 멀어요."],["Nous sommes loin de la maison.","우리는 집에서 멀리 와 있어요."]]},{"word":"la maison","ipa":"/la mɛ.zɔ̃/","meaning":"집","nuance":"사는 장소를 뜻하는 기본 명사입니다.","examples":[["Je suis à la maison.","저는 집에 있어요."],["La maison est près du parc.","집은 공원 근처에 있어요."],["Nous rentrons à la maison.","우리는 집에 돌아가요."],["J'aime cette maison.","저는 이 집이 좋아요."]]},{"word":"le travail","ipa":"/lə tʁa.vaj/","meaning":"일, 직장","nuance":"업무나 직장을 뜻합니다.","examples":[["Je vais au travail.","저는 출근해요."],["J'ai beaucoup de travail aujourd'hui.","오늘 일이 많아요."],["Elle aime son travail.","그녀는 자기 일을 좋아해요."],["Nous parlons du travail.","우리는 일에 대해 이야기해요."]]},{"word":"l'école","ipa":"/le.kɔl/","meaning":"학교","nuance":"교육기관을 뜻합니다.","examples":[["Les enfants vont à l'école.","아이들은 학교에 가요."],["L'école est près d'ici.","학교는 여기서 가까워요."],["Je travaille dans une école.","저는 학교에서 일해요."],["L'école commence à huit heures.","학교는 8시에 시작해요."]]},{"word":"la gare","ipa":"/la ɡaʁ/","meaning":"역","nuance":"기차역을 뜻합니다.","examples":[["Où est la gare ?","역이 어디예요?"],["Je vous attends à la gare.","역에서 기다릴게요."],["La gare est près du centre.","역은 중심가 근처에 있어요."],["Nous arrivons à la gare à neuf heures.","우리는 9시에 역에 도착해요."]]},{"word":"le restaurant","ipa":"/lə ʁɛs.to.ʁɑ̃/","meaning":"식당","nuance":"식사를 하는 장소를 뜻합니다.","examples":[["Ce restaurant est très bon.","이 식당은 아주 좋아요."],["Nous allons au restaurant ce soir.","우리는 오늘 저녁 식당에 가요."],["Le restaurant ouvre à midi.","식당은 정오에 열어요."],["Je cherche un restaurant français.","저는 프랑스 식당을 찾고 있어요."]]},{"word":"le café","ipa":"/lə ka.fe/","meaning":"카페, 커피","nuance":"장소인 카페와 음료인 커피를 모두 뜻합니다.","examples":[["Je prends un café.","저는 커피를 마셔요."],["On se retrouve au café.","카페에서 만나요."],["Ce café est très calme.","이 카페는 아주 조용해요."],["Le café est trop chaud.","커피가 너무 뜨거워요."]]},{"word":"l'eau","ipa":"/lo/","meaning":"물","nuance":"마시는 물을 뜻합니다.","examples":[["Je voudrais de l'eau, s'il vous plaît.","물 주세요."],["Je bois beaucoup d'eau.","저는 물을 많이 마셔요."],["L'eau est froide.","물이 차가워요."],["Il y a de l'eau sur la table.","탁자 위에 물이 있어요."]]},{"word":"le pain","ipa":"/lə pɛ̃/","meaning":"빵","nuance":"프랑스 일상에서 매우 자주 쓰는 기본 명사입니다.","examples":[["J'achète du pain.","저는 빵을 사요."],["Le pain est frais.","빵이 신선해요."],["Nous mangeons du pain au petit déjeuner.","우리는 아침에 빵을 먹어요."],["Il reste un peu de pain.","빵이 조금 남아 있어요."]]},{"word":"le fromage","ipa":"/lə fʁɔ.maʒ/","meaning":"치즈","nuance":"프랑스 음식 관련 핵심 단어입니다.","examples":[["J'aime le fromage.","저는 치즈를 좋아해요."],["Ce fromage est très bon.","이 치즈는 아주 맛있어요."],["Nous achetons du fromage au marché.","우리는 시장에서 치즈를 사요."],["Tu veux un peu de fromage ?","치즈 조금 먹을래요?"]]},{"word":"l'argent","ipa":"/laʁ.ʒɑ̃/","meaning":"돈","nuance":"돈이나 금전을 뜻합니다.","examples":[["Je n'ai pas beaucoup d'argent.","저는 돈이 많지 않아요."],["Il faut économiser de l'argent.","돈을 절약해야 해요."],["Où peut-on changer de l'argent ?","어디서 환전할 수 있어요?"],["Elle gagne assez d'argent.","그녀는 돈을 충분히 벌어요."]]},{"word":"le temps","ipa":"/lə tɑ̃/","meaning":"시간, 날씨","nuance":"문맥에 따라 시간 또는 날씨를 뜻합니다.","examples":[["Je n'ai pas le temps.","저는 시간이 없어요."],["Quel temps fait-il ?","날씨가 어때요?"],["Nous avons encore du temps.","우리는 아직 시간이 있어요."],["Le temps passe vite.","시간이 빨리 가요."]]},{"word":"la journée","ipa":"/la ʒuʁ.ne/","meaning":"하루, 낮 시간","nuance":"하루의 활동 시간대를 말합니다.","examples":[["Bonne journée !","좋은 하루 보내세요!"],["J'ai travaillé toute la journée.","저는 하루 종일 일했어요."],["La journée commence tôt.","하루가 일찍 시작돼요."],["C'était une longue journée.","긴 하루였어요."]]},{"word":"le matin","ipa":"/lə ma.tɛ̃/","meaning":"아침","nuance":"아침 시간대를 뜻합니다.","examples":[["Je me lève tôt le matin.","저는 아침에 일찍 일어나요."],["Je bois du café le matin.","저는 아침에 커피를 마셔요."],["On se voit demain matin.","내일 아침에 봐요."],["Le matin, il fait frais.","아침에는 선선해요."]]},{"word":"le soir","ipa":"/lə swaʁ/","meaning":"저녁, 밤","nuance":"저녁 시간대를 뜻합니다.","examples":[["Je lis le soir.","저는 저녁에 책을 읽어요."],["On dîne ensemble ce soir ?","오늘 저녁 같이 식사할까요?"],["Le soir, je suis souvent fatigué.","저녁에는 자주 피곤해요."],["À ce soir !","오늘 저녁에 봐요!"]]},{"word":"la semaine","ipa":"/la sə.mɛn/","meaning":"주","nuance":"7일 단위의 시간을 뜻합니다.","examples":[["Cette semaine, je suis très occupé.","이번 주는 아주 바빠요."],["Nous partons la semaine prochaine.","우리는 다음 주에 떠나요."],["Je travaille cinq jours par semaine.","저는 일주일에 5일 일해요."],["La semaine passe vite.","한 주가 빨리 가요."]]},{"word":"le week-end","ipa":"/lə wi.kɛnd/","meaning":"주말","nuance":"토요일과 일요일을 가리킵니다.","examples":[["Qu'est-ce que tu fais ce week-end ?","이번 주말에 뭐 해요?"],["Je me repose le week-end.","저는 주말에 쉬어요."],["Nous partons en voyage ce week-end.","우리는 이번 주말에 여행을 떠나요."],["Le café est plein le week-end.","주말에는 카페가 붐벼요."]]}]