[{"word":"今天","pinyin":"jīn tiān","meaning":"오늘","nuance":"현재 날짜를 가리키는 기본 시간 표현입니다.","examples":[["今天天气很好。","오늘 날씨가 좋아요."],["你今天忙吗？","오늘 바빠요?"],["今天是星期五。","오늘은 금요일이에요."],["我今天不工作。","저는 오늘 일하지 않아요."]]},{"word":"明天","pinyin":"míng tiān","meaning":"내일","nuance":"오늘의 다음 날을 뜻합니다.","examples":[["明天见。","내일 봐요."],["明天会下雨。","내일 비가 올 거예요."],["你明天有时间吗？","내일 시간 있어요?"],["我们明天再决定。","우리 내일 다시 결정해요."]]},{"word":"昨天","pinyin":"zuó tiān","meaning":"어제","nuance":"오늘의 전날을 뜻합니다.","examples":[["昨天我很忙。","어제 저는 매우 바빴어요."],["你昨天去哪儿了？","어제 어디 갔어요?"],["我昨天买了这本书。","어제 이 책을 샀어요."],["昨天下了一整天雨。","어제 하루 종일 비가 왔어요."]]},{"word":"现在","pinyin":"xiàn zài","meaning":"지금, 현재","nuance":"현재 시점이나 현재 상황을 나타냅니다.","examples":[["你现在在哪儿？","지금 어디예요?"],["我现在很忙。","저는 지금 매우 바빠요."],["现在可以开始吗？","지금 시작해도 돼요?"],["现在已经十点了。","지금 벌써 10시예요."]]},{"word":"早上","pinyin":"zǎo shang","meaning":"아침","nuance":"아침 시간대를 뜻합니다.","examples":[["我早上七点起床。","저는 아침 7시에 일어나요."],["早上好。","좋은 아침이에요."],["我早上喝咖啡。","저는 아침에 커피를 마셔요."],["明天早上见。","내일 아침에 봐요."]]},{"word":"下午","pinyin":"xià wǔ","meaning":"오후","nuance":"정오 이후부터 저녁 전까지를 가리킵니다.","examples":[["下午三点见。","오후 3시에 봐요."],["我下午有会议。","저는 오후에 회의가 있어요."],["今天下午有点忙。","오늘 오후는 조금 바빠요."],["下午我们去喝咖啡吧。","오후에 우리 커피 마시러 가요."]]},{"word":"晚上","pinyin":"wǎn shang","meaning":"저녁, 밤","nuance":"저녁부터 밤 시간대를 뜻합니다.","examples":[["晚上你有时间吗？","저녁에 시간 있어요?"],["我晚上不喝咖啡。","저는 밤에는 커피를 마시지 않아요."],["今天晚上很冷。","오늘 밤은 추워요."],["我们晚上一起吃饭。","우리 저녁에 같이 밥 먹어요."]]},{"word":"时间","pinyin":"shí jiān","meaning":"시간","nuance":"시간이라는 개념이나 일정상의 시간을 뜻합니다.","examples":[["你有时间吗？","시간 있어요?"],["我没有时间。","저는 시간이 없어요."],["时间过得很快。","시간이 아주 빨리 가요."],["我们需要一点时间。","우리는 시간이 조금 필요해요."]]},{"word":"分钟","pinyin":"fēn zhōng","meaning":"분","nuance":"시간 단위 ‘분’을 뜻합니다.","examples":[["请等五分钟。","5분만 기다려 주세요."],["走路需要十分钟。","걸어서 10분 걸려요."],["会议还有二十分钟。","회의까지 20분 남았어요."],["我每天学习三十分钟。","저는 매일 30분 공부해요."]]},{"word":"星期","pinyin":"xīng qī","meaning":"주, 요일","nuance":"요일을 말할 때 星期一처럼 사용합니다.","examples":[["今天星期几？","오늘 무슨 요일이에요?"],["今天是星期五。","오늘은 금요일이에요."],["我们下个星期见。","우리 다음 주에 봐요."],["这个星期我很忙。","이번 주 저는 매우 바빠요."]]},{"word":"家","pinyin":"jiā","meaning":"집, 가족","nuance":"사는 장소인 집이나 가족을 가리킬 수 있습니다.","examples":[["我现在在家。","저는 지금 집에 있어요."],["我家离公司很近。","우리 집은 회사에서 가까워요."],["周末我想在家休息。","주말에는 집에서 쉬고 싶어요."],["我们家有一只猫。","우리 집에는 고양이 한 마리가 있어요."]]},{"word":"学校","pinyin":"xué xiào","meaning":"학교","nuance":"공부하는 기관을 뜻합니다.","examples":[["我去学校。","저는 학교에 가요."],["学校离这里不远。","학교는 여기서 멀지 않아요."],["她在学校学习中文。","그녀는 학교에서 중국어를 배워요."],["学校八点开始上课。","학교는 8시에 수업을 시작해요."]]},{"word":"公司","pinyin":"gōng sī","meaning":"회사","nuance":"일하는 조직이나 기업을 뜻합니다.","examples":[["我在公司工作。","저는 회사에서 일해요."],["公司离地铁站很近。","회사는 지하철역에서 가까워요."],["我们公司很小。","우리 회사는 작아요."],["今天公司有会议。","오늘 회사에 회의가 있어요."]]},{"word":"商店","pinyin":"shāng diàn","meaning":"상점, 가게","nuance":"물건을 사고파는 가게를 뜻합니다.","examples":[["这家商店很大。","이 가게는 매우 커요."],["商店几点关门？","가게는 몇 시에 닫아요?"],["我去商店买东西。","저는 가게에 물건 사러 가요."],["附近有商店吗？","근처에 가게가 있나요?"]]},{"word":"医院","pinyin":"yī yuàn","meaning":"병원","nuance":"진료·치료를 받는 의료기관입니다.","examples":[["医院在哪里？","병원이 어디에 있어요?"],["我明天去医院。","저는 내일 병원에 가요."],["她在医院工作。","그녀는 병원에서 일해요."],["这家医院很大。","이 병원은 매우 커요."]]},{"word":"车站","pinyin":"chē zhàn","meaning":"정류장, 역","nuance":"버스나 기차 등을 타는 장소를 뜻합니다.","examples":[["车站在哪里？","정류장이 어디에 있어요?"],["我在车站等你。","역에서 기다릴게요."],["从这里到车站很近。","여기서 역까지 가까워요."],["我们八点在车站见。","우리 8시에 역에서 만나요."]]},{"word":"餐厅","pinyin":"cān tīng","meaning":"식당","nuance":"식사를 하는 식당을 뜻합니다.","examples":[["这家餐厅很好吃。","이 식당 음식은 맛있어요."],["附近有餐厅吗？","근처에 식당이 있나요?"],["我们去餐厅吃饭吧。","우리 식당에 밥 먹으러 가요."],["这家餐厅有点贵。","이 식당은 조금 비싸요."]]},{"word":"朋友","pinyin":"péng you","meaning":"친구","nuance":"친구를 뜻하는 기본 명사입니다.","examples":[["他是我的朋友。","그는 제 친구예요."],["我和朋友一起吃饭。","저는 친구와 같이 밥을 먹어요."],["朋友今天来我家。","친구가 오늘 우리 집에 와요."],["我有很多中国朋友。","저는 중국인 친구가 많아요."]]},{"word":"家人","pinyin":"jiā rén","meaning":"가족","nuance":"가족 구성원을 통틀어 말합니다.","examples":[["我的家人在韩国。","제 가족은 한국에 있어요."],["周末我和家人在一起。","주말에는 가족과 함께 있어요."],["她很关心家人。","그녀는 가족을 많이 챙겨요."],["我想给家人打电话。","가족에게 전화하고 싶어요."]]},{"word":"老师","pinyin":"lǎo shī","meaning":"선생님","nuance":"교사를 부르거나 지칭할 때 씁니다.","examples":[["她是我的中文老师。","그녀는 제 중국어 선생님이에요."],["老师，您好。","선생님, 안녕하세요."],["老师说得很清楚。","선생님이 아주 명확하게 설명해요."],["我想问老师一个问题。","선생님께 질문 하나 하고 싶어요."]]}]