[{"word":"慢","pinyin":"màn","meaning":"느리다","nuance":"속도가 느린 것을 나타냅니다.","examples":[["请说慢一点。","천천히 말해 주세요."],["今天网络很慢。","오늘 인터넷이 느려요."],["他走得很慢。","그는 천천히 걸어요."],["别着急，慢慢来。","서두르지 말고 천천히 하세요."]]},{"word":"忙","pinyin":"máng","meaning":"바쁘다","nuance":"할 일이 많아 시간이 없는 상태를 말합니다.","examples":[["我今天很忙。","저는 오늘 매우 바빠요."],["你最近忙吗？","요즘 바빠요?"],["下午有点忙。","오후에는 조금 바빠요."],["忙完以后给我打电话。","바쁜 일 끝나면 전화해 주세요."]]},{"word":"累","pinyin":"lèi","meaning":"피곤하다","nuance":"몸이나 정신이 지친 상태를 말합니다.","examples":[["我今天有点累。","오늘 조금 피곤해요."],["工作一天以后很累。","하루 종일 일하면 피곤해요."],["你累不累？","피곤해요?"],["累了就休息一下。","피곤하면 좀 쉬세요."]]},{"word":"开心","pinyin":"kāi xīn","meaning":"기쁘다, 즐겁다","nuance":"기분이 좋고 즐거운 상태를 나타냅니다.","examples":[["今天我很开心。","오늘 저는 매우 기뻐요."],["见到你很开心。","당신을 만나서 기뻐요."],["孩子们玩得很开心。","아이들이 즐겁게 놀고 있어요."],["希望你每天都开心。","매일 행복하길 바라요."]]},{"word":"重要","pinyin":"zhòng yào","meaning":"중요하다","nuance":"가치나 영향이 큰 것을 나타냅니다.","examples":[["这个问题很重要。","이 문제는 매우 중요해요."],["时间很重要。","시간은 중요해요."],["健康比什么都重要。","건강이 무엇보다 중요해요."],["请记住这个重要信息。","이 중요한 정보를 기억해 주세요."]]},{"word":"容易","pinyin":"róng yì","meaning":"쉽다","nuance":"어떤 일을 하기가 어렵지 않음을 나타냅니다.","examples":[["这个问题很容易。","이 문제는 쉬워요."],["这个字很容易写。","이 글자는 쓰기 쉬워요."],["学会说不太容易。","말하는 법을 익히는 건 그리 쉽지 않아요."],["这里很容易找到。","여기는 찾기 쉬워요."]]},{"word":"难","pinyin":"nán","meaning":"어렵다","nuance":"어떤 일을 하거나 이해하기가 어려운 상태입니다.","examples":[["这个问题很难。","이 문제는 어려워요."],["中文发音有点难。","중국어 발음은 조금 어려워요."],["这个字很难写。","이 글자는 쓰기 어려워요."],["我觉得不太难。","저는 그리 어렵지 않다고 생각해요."]]},{"word":"漂亮","pinyin":"piào liang","meaning":"예쁘다, 아름답다","nuance":"사람·물건·풍경 등이 아름답다고 말할 때 씁니다.","examples":[["这件衣服很漂亮。","이 옷은 예뻐요."],["这里的风景很漂亮。","여기 풍경이 아름다워요."],["你的照片拍得很漂亮。","당신 사진이 아주 예쁘게 찍혔어요."],["这个颜色很漂亮。","이 색은 예뻐요."]]},{"word":"便宜","pinyin":"pián yi","meaning":"싸다","nuance":"가격이 낮거나 합리적일 때 씁니다.","examples":[["这个很便宜。","이거 아주 싸요."],["有没有更便宜的？","더 싼 거 있나요?"],["这家店的水果很便宜。","이 가게 과일은 싸요."],["网上买可能更便宜。","온라인으로 사면 더 쌀 수도 있어요."]]},{"word":"贵","pinyin":"guì","meaning":"비싸다","nuance":"가격이 높은 것을 나타냅니다.","examples":[["这个太贵了。","이건 너무 비싸요."],["这家餐厅有点贵。","이 식당은 조금 비싸요."],["有没有不太贵的？","너무 비싸지 않은 거 있나요?"],["房租越来越贵。","집세가 점점 비싸지고 있어요."]]},{"word":"因为","pinyin":"yīn wèi","meaning":"왜냐하면, ~때문에","nuance":"이유를 제시할 때 사용하며 所以와 자주 함께 씁니다.","examples":[["因为下雨，我没去。","비가 와서 저는 가지 않았어요."],["因为很忙，他来不了。","너무 바빠서 그는 올 수 없어요."],["我喜欢这里，因为很安静。","여기가 조용해서 좋아해요."],["因为堵车，我迟到了。","차가 막혀서 늦었어요."]]},{"word":"所以","pinyin":"suǒ yǐ","meaning":"그래서","nuance":"앞의 이유에 따른 결과를 말할 때 씁니다.","examples":[["今天下雨，所以我没出去。","오늘 비가 와서 저는 밖에 안 나갔어요."],["我很累，所以想早点睡。","피곤해서 일찍 자고 싶어요."],["他很忙，所以不能来。","그는 바빠서 올 수 없어요."],["这里很近，所以我们走路去。","여기는 가까워서 걸어가요."]]},{"word":"但是","pinyin":"dàn shì","meaning":"하지만","nuance":"앞뒤 내용을 대조하거나 반전할 때 씁니다.","examples":[["我很累，但是还要工作。","피곤하지만 아직 일해야 해요."],["这个很贵，但是很好用。","이건 비싸지만 사용하기 좋아요."],["天气冷，但是很晴朗。","날씨는 춥지만 맑아요."],["我想去，但是没有时间。","가고 싶지만 시간이 없어요."]]},{"word":"如果","pinyin":"rú guǒ","meaning":"만약 ~라면","nuance":"조건을 제시할 때 사용합니다.","examples":[["如果下雨，我们就不去。","비가 오면 우리는 가지 않을 거예요."],["如果你有时间，给我打电话。","시간 있으면 전화해 주세요."],["如果不懂，可以问我。","이해가 안 되면 저에게 물어봐도 돼요."],["如果太贵，我就不买。","너무 비싸면 저는 안 살 거예요."]]},{"word":"还是","pinyin":"hái shi","meaning":"아니면, 그래도","nuance":"선택 질문에서 A还是B 형태로 매우 자주 씁니다.","examples":[["你要咖啡还是茶？","커피와 차 중 무엇을 원해요?"],["今天去还是明天去？","오늘 갈까요, 내일 갈까요?"],["你坐地铁还是公交车？","지하철 타요, 버스 타요?"],["虽然很累，我还是去了。","매우 피곤했지만 그래도 갔어요."]]},{"word":"已经","pinyin":"yǐ jīng","meaning":"이미, 벌써","nuance":"어떤 상태나 일이 이미 완료되었음을 나타냅니다.","examples":[["我已经吃饭了。","저는 이미 밥을 먹었어요."],["他已经回家了。","그는 이미 집에 갔어요."],["现在已经十点了。","지금 벌써 10시예요."],["我已经看过这部电影。","저는 이 영화를 이미 봤어요."]]},{"word":"一起","pinyin":"yì qǐ","meaning":"함께","nuance":"둘 이상이 같은 행동을 할 때 씁니다.","examples":[["我们一起去吧。","우리 같이 가요."],["一起吃饭吗？","같이 밥 먹을래요?"],["我和朋友一起学习。","저는 친구와 함께 공부해요."],["周末我们一起看电影。","주말에 우리 같이 영화 봐요."]]},{"word":"可能","pinyin":"kě néng","meaning":"아마, 가능하다","nuance":"확실하지 않은 가능성을 나타냅니다.","examples":[["明天可能下雨。","내일 비가 올 수도 있어요."],["他今天可能不来。","그는 오늘 안 올 수도 있어요."],["这个办法可能更好。","이 방법이 더 좋을 수도 있어요."],["我可能会晚一点。","제가 조금 늦을 수도 있어요."]]},{"word":"当然","pinyin":"dāng rán","meaning":"물론","nuance":"강한 긍정이나 당연함을 나타냅니다.","examples":[["当然可以。","물론 가능해요."],["你想去吗？当然想。","가고 싶어요? 물론이죠."],["当然，我可以帮你。","물론이죠, 제가 도와드릴게요."],["这当然很重要。","이건 당연히 매우 중요해요."]]},{"word":"特别","pinyin":"tè bié","meaning":"특별히, 매우","nuance":"일반적이지 않거나 정도가 특히 강함을 나타냅니다.","examples":[["今天特别冷。","오늘 특히 추워요."],["我特别喜欢这家店。","저는 이 가게를 특히 좋아해요."],["这个地方很特别。","이곳은 매우 특별해요."],["她今天特别忙。","그녀는 오늘 특히 바빠요."]]}]