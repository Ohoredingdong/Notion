[{"word":"学生","pinyin":"xué sheng","meaning":"학생","nuance":"학교나 교육기관에서 배우는 사람입니다.","examples":[["我是大学生。","저는 대학생이에요."],["学生都在教室里。","학생들이 모두 교실에 있어요."],["她是一个很认真的学生。","그녀는 매우 성실한 학생이에요."],["这个班有二十个学生。","이 반에는 학생이 20명 있어요."]]},{"word":"钱","pinyin":"qián","meaning":"돈","nuance":"화폐나 비용을 뜻하는 기본 명사입니다.","examples":[["这个多少钱？","이거 얼마예요?"],["我没有带钱。","돈을 안 가져왔어요."],["这里可以换钱吗？","여기서 환전할 수 있나요?"],["我想省一点钱。","돈을 조금 아끼고 싶어요."]]},{"word":"东西","pinyin":"dōng xi","meaning":"물건, 것","nuance":"구체적인 물건을 두루 가리키는 매우 자주 쓰는 말입니다.","examples":[["我去买东西。","물건 사러 가요."],["这是什么东西？","이게 무슨 물건이에요?"],["我的东西在这里。","제 물건은 여기 있어요."],["别忘了拿你的东西。","네 물건 챙기는 걸 잊지 마."]]},{"word":"水","pinyin":"shuǐ","meaning":"물","nuance":"마시는 물을 뜻합니다.","examples":[["请给我一杯水。","물 한 잔 주세요."],["我每天喝很多水。","저는 매일 물을 많이 마셔요."],["这个水有点凉。","이 물은 조금 차가워요."],["桌子上有一瓶水。","책상 위에 물 한 병이 있어요."]]},{"word":"咖啡","pinyin":"kā fēi","meaning":"커피","nuance":"커피 음료를 뜻합니다.","examples":[["我喜欢喝咖啡。","저는 커피 마시는 걸 좋아해요."],["你要咖啡还是茶？","커피와 차 중 무엇을 원해요?"],["这家店的咖啡很好喝。","이 가게 커피는 맛있어요."],["晚上我不喝咖啡。","저녁에는 커피를 마시지 않아요."]]},{"word":"茶","pinyin":"chá","meaning":"차","nuance":"차 음료를 뜻합니다.","examples":[["我喜欢喝茶。","저는 차 마시는 걸 좋아해요."],["请给我一杯热茶。","따뜻한 차 한 잔 주세요."],["中国有很多种茶。","중국에는 여러 종류의 차가 있어요."],["你想喝绿茶吗？","녹차 마시고 싶어요?"]]},{"word":"米饭","pinyin":"mǐ fàn","meaning":"밥, 쌀밥","nuance":"익힌 쌀밥을 뜻합니다.","examples":[["我想吃米饭。","밥 먹고 싶어요."],["这里的米饭很好吃。","여기 밥은 맛있어요."],["请给我一碗米饭。","밥 한 그릇 주세요."],["我每天中午吃米饭。","저는 매일 점심에 밥을 먹어요."]]},{"word":"菜","pinyin":"cài","meaning":"요리, 채소","nuance":"문맥에 따라 요리나 채소를 뜻합니다.","examples":[["这个菜很好吃。","이 요리는 맛있어요."],["我想点两个菜。","요리 두 개 주문하고 싶어요."],["她很会做中国菜。","그녀는 중국 요리를 잘해요."],["多吃一点蔬菜。","채소를 좀 더 먹어요."]]},{"word":"天气","pinyin":"tiān qì","meaning":"날씨","nuance":"기온·비·바람 등 날씨 상태를 뜻합니다.","examples":[["今天天气很好。","오늘 날씨가 좋아요."],["明天天气怎么样？","내일 날씨 어때요?"],["最近天气很冷。","요즘 날씨가 매우 추워요."],["我喜欢秋天的天气。","저는 가을 날씨를 좋아해요."]]},{"word":"热","pinyin":"rè","meaning":"덥다, 뜨겁다","nuance":"기온이나 물건의 온도가 높은 상태를 말합니다.","examples":[["今天很热。","오늘 매우 더워요."],["这杯咖啡太热了。","이 커피는 너무 뜨거워요."],["夏天这里很热。","여름에 여기는 매우 더워요."],["我有点热，想开窗。","조금 더워서 창문을 열고 싶어요."]]},{"word":"冷","pinyin":"lěng","meaning":"춥다, 차갑다","nuance":"기온이나 물건의 온도가 낮은 상태를 말합니다.","examples":[["今天有点冷。","오늘 조금 추워요."],["水太冷了。","물이 너무 차가워요."],["冬天这里很冷。","겨울에 여기는 아주 추워요."],["你冷不冷？","추워요?"]]},{"word":"大","pinyin":"dà","meaning":"크다","nuance":"크기·규모·나이 등이 큰 것을 나타냅니다.","examples":[["这个房间很大。","이 방은 커요."],["北京是一个大城市。","베이징은 큰 도시예요."],["这家公司很大。","이 회사는 규모가 커요."],["我要大杯咖啡。","큰 사이즈 커피 주세요."]]},{"word":"小","pinyin":"xiǎo","meaning":"작다","nuance":"크기·규모·나이 등이 작은 것을 나타냅니다.","examples":[["这个杯子太小了。","이 컵은 너무 작아요."],["我住在一个小城市。","저는 작은 도시에 살아요."],["这家店很小，但是很舒服。","이 가게는 작지만 편안해요."],["给我小份就可以。","작은 양이면 돼요."]]},{"word":"多","pinyin":"duō","meaning":"많다","nuance":"수량이나 정도가 많은 것을 나타냅니다.","examples":[["今天人很多。","오늘 사람이 많아요."],["这里有很多商店。","여기에는 가게가 많아요."],["请多喝水。","물을 많이 마셔 주세요."],["我还有很多问题。","저는 아직 질문이 많아요."]]},{"word":"少","pinyin":"shǎo","meaning":"적다","nuance":"수량이나 정도가 적은 것을 나타냅니다.","examples":[["今天人很少。","오늘 사람이 적어요."],["我喝咖啡比较少。","저는 커피를 비교적 적게 마셔요."],["这里的车比较少。","여기는 차가 비교적 적어요."],["请少放一点糖。","설탕을 조금만 넣어 주세요."]]},{"word":"好","pinyin":"hǎo","meaning":"좋다","nuance":"상태·품질·감정 등이 좋음을 나타내는 핵심 형용사입니다.","examples":[["今天天气很好。","오늘 날씨가 좋아요."],["这个办法很好。","이 방법은 좋아요."],["你好！","안녕하세요!"],["我已经准备好了。","저는 이미 준비됐어요."]]},{"word":"坏","pinyin":"huài","meaning":"나쁘다, 고장 나다","nuance":"상태나 품질이 좋지 않거나 물건이 고장 난 것을 나타냅니다.","examples":[["天气变坏了。","날씨가 나빠졌어요."],["我的手机坏了。","제 휴대폰이 고장 났어요."],["这不是一个坏主意。","이건 나쁜 생각은 아니에요."],["食物已经坏了。","음식이 이미 상했어요."]]},{"word":"新","pinyin":"xīn","meaning":"새롭다, 새것","nuance":"새로 생겼거나 사용한 지 오래되지 않은 것을 뜻합니다.","examples":[["这是我的新手机。","이건 제 새 휴대폰이에요."],["公司来了新同事。","회사에 새 동료가 왔어요."],["我想学一个新词。","새 단어 하나를 배우고 싶어요."],["这家店是新开的。","이 가게는 새로 열었어요."]]},{"word":"旧","pinyin":"jiù","meaning":"낡다, 오래되다","nuance":"새것의 반대인 오래된 상태를 말합니다.","examples":[["这台电脑有点旧。","이 컴퓨터는 조금 오래됐어요."],["我还在用旧手机。","저는 아직 예전 휴대폰을 쓰고 있어요."],["这个房子很旧。","이 집은 오래됐어요."],["我把旧衣服送人了。","헌 옷을 다른 사람에게 줬어요."]]},{"word":"快","pinyin":"kuài","meaning":"빠르다","nuance":"속도나 시간이 빠른 것을 나타냅니다.","examples":[["他跑得很快。","그는 아주 빨리 달려요."],["时间过得真快。","시간이 정말 빨리 가요."],["请快一点。","조금 빨리 해 주세요."],["地铁比公交车快。","지하철이 버스보다 빨라요."]]}]