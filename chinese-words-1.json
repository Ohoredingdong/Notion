[{"word":"你好","pinyin":"nǐ hǎo","meaning":"안녕하세요","nuance":"가장 기본적인 인사 표현입니다.","examples":[["你好，很高兴认识你。","안녕하세요, 만나서 반가워요."],["老师，你好。","선생님, 안녕하세요."],["大家好，我叫安娜。","여러분 안녕하세요, 저는 안나예요."],["你好，请问这里有人吗？","안녕하세요, 실례지만 여기 사람 있나요?"]]},{"word":"谢谢","pinyin":"xiè xie","meaning":"감사합니다","nuance":"감사를 표현할 때 가장 널리 쓰는 말입니다.","examples":[["谢谢你的帮助。","도와줘서 고마워요."],["真的很谢谢你。","정말 고마워요."],["谢谢，我自己来。","고마워요, 제가 할게요."],["谢谢你今天来。","오늘 와줘서 고마워요."]]},{"word":"对不起","pinyin":"duì bu qǐ","meaning":"미안합니다","nuance":"사과할 때 쓰는 기본 표현입니다.","examples":[["对不起，我来晚了。","미안해요, 제가 늦었어요."],["对不起，我没听清楚。","미안해요, 잘 못 들었어요."],["真的对不起。","정말 미안해요."],["对不起，可以再说一次吗？","미안하지만 한 번 더 말해줄 수 있나요?"]]},{"word":"没关系","pinyin":"méi guān xi","meaning":"괜찮아요","nuance":"사과에 답할 때 ‘괜찮아요’라는 뜻으로 자주 씁니다.","examples":[["没关系，别担心。","괜찮아요, 걱정하지 마세요."],["没关系，我们还有时间。","괜찮아요, 아직 시간이 있어요."],["迟一点也没关系。","조금 늦어도 괜찮아요."],["没关系，下次注意就好。","괜찮아요, 다음에 조심하면 돼요."]]},{"word":"请","pinyin":"qǐng","meaning":"부탁합니다, ~해주세요","nuance":"정중하게 요청하거나 권할 때 문장 앞에 자주 옵니다.","examples":[["请坐。","앉으세요."],["请等一下。","잠시 기다려 주세요."],["请慢一点说。","조금 천천히 말해 주세요."],["请给我一杯水。","물 한 잔 주세요."]]},{"word":"再见","pinyin":"zài jiàn","meaning":"안녕히 가세요, 또 봐요","nuance":"헤어질 때 쓰는 가장 기본적인 인사입니다.","examples":[["再见，明天见。","안녕, 내일 봐요."],["老师，再见。","선생님, 안녕히 계세요."],["我们下周再见。","우리 다음 주에 다시 봐요."],["时间不早了，再见。","시간이 늦었네요, 안녕히 가세요."]]},{"word":"是","pinyin":"shì","meaning":"~이다","nuance":"명사와 명사를 연결해 신분·정체 등을 말할 때 씁니다.","examples":[["我是韩国人。","저는 한국인이에요."],["她是我的朋友。","그녀는 제 친구예요."],["今天是星期五。","오늘은 금요일이에요."],["这是我的书。","이것은 제 책이에요."]]},{"word":"有","pinyin":"yǒu","meaning":"있다, 가지다","nuance":"소유나 존재를 나타낼 때 사용합니다.","examples":[["我有一个问题。","질문이 하나 있어요."],["这里有咖啡吗？","여기 커피 있나요?"],["他有两个妹妹。","그에게는 여동생이 둘 있어요."],["今天我有时间。","오늘 저는 시간이 있어요."]]},{"word":"在","pinyin":"zài","meaning":"~에 있다, ~에서","nuance":"위치나 동작이 진행되는 장소를 나타낼 때 씁니다.","examples":[["我在家。","저는 집에 있어요."],["她在公司工作。","그녀는 회사에서 일해요."],["书在桌子上。","책은 책상 위에 있어요."],["我在等朋友。","저는 친구를 기다리고 있어요."]]},{"word":"去","pinyin":"qù","meaning":"가다","nuance":"어떤 장소로 이동할 때 씁니다.","examples":[["我明天去学校。","저는 내일 학교에 가요."],["你想去哪儿？","어디에 가고 싶어요?"],["我们一起去吃饭吧。","우리 같이 밥 먹으러 가요."],["他去北京出差了。","그는 베이징으로 출장 갔어요."]]},{"word":"来","pinyin":"lái","meaning":"오다","nuance":"화자 쪽으로 이동하거나 어떤 일이 도래할 때 씁니다.","examples":[["你什么时候来？","언제 와요?"],["朋友来我家了。","친구가 우리 집에 왔어요."],["请进来坐。","들어와서 앉으세요."],["春天快来了。","봄이 곧 와요."]]},{"word":"看","pinyin":"kàn","meaning":"보다","nuance":"눈으로 보거나, 읽거나, 방문·진찰받는 맥락에서도 쓰입니다.","examples":[["我喜欢看电影。","저는 영화 보는 걸 좋아해요."],["你看这个。","이것 좀 보세요."],["我晚上看书。","저는 저녁에 책을 읽어요."],["明天我要去看医生。","내일 저는 의사에게 진료받으러 갈 거예요."]]},{"word":"听","pinyin":"tīng","meaning":"듣다","nuance":"소리나 말을 귀로 듣는 동작입니다.","examples":[["我喜欢听音乐。","저는 음악 듣는 걸 좋아해요."],["你听得懂吗？","듣고 이해할 수 있어요?"],["请听我说。","제 말 좀 들어주세요."],["我每天听中文新闻。","저는 매일 중국어 뉴스를 들어요."]]},{"word":"说","pinyin":"shuō","meaning":"말하다","nuance":"말하거나 어떤 내용을 표현할 때 씁니다.","examples":[["你会说中文吗？","중국어 할 줄 알아요?"],["请慢一点说。","조금 천천히 말해 주세요."],["他说今天很忙。","그는 오늘 매우 바쁘다고 말했어요."],["这句话怎么说？","이 문장은 어떻게 말해요?"]]},{"word":"读","pinyin":"dú","meaning":"읽다","nuance":"글·책·문장을 읽을 때 씁니다.","examples":[["我每天读中文。","저는 매일 중국어를 읽어요."],["请读这个句子。","이 문장을 읽어 주세요."],["这本书很好读。","이 책은 읽기 쉬워요."],["她在大学读书。","그녀는 대학에서 공부해요."]]},{"word":"写","pinyin":"xiě","meaning":"쓰다","nuance":"글자·문장·메시지 등을 적을 때 씁니다.","examples":[["请写你的名字。","이름을 써 주세요."],["我在写邮件。","저는 이메일을 쓰고 있어요."],["这个字怎么写？","이 글자는 어떻게 써요?"],["她喜欢写日记。","그녀는 일기 쓰는 걸 좋아해요."]]},{"word":"学","pinyin":"xué","meaning":"배우다, 공부하다","nuance":"새로운 지식이나 기술을 배우는 것을 뜻합니다.","examples":[["我在学中文。","저는 중국어를 배우고 있어요."],["我们一起学吧。","우리 같이 공부해요."],["她学得很快。","그녀는 아주 빨리 배워요."],["学语言需要时间。","언어를 배우는 데는 시간이 필요해요."]]},{"word":"工作","pinyin":"gōng zuò","meaning":"일하다, 업무","nuance":"직업이나 업무를 뜻하는 매우 자주 쓰는 말입니다.","examples":[["我在首尔工作。","저는 서울에서 일해요."],["今天工作很多。","오늘 일이 많아요."],["他九点开始工作。","그는 9시에 일을 시작해요."],["这个工作很重要。","이 업무는 매우 중요해요."]]},{"word":"喜欢","pinyin":"xǐ huan","meaning":"좋아하다","nuance":"사람·음식·활동 등을 좋아한다고 말할 때 씁니다.","examples":[["我喜欢喝茶。","저는 차 마시는 걸 좋아해요."],["你喜欢什么颜色？","어떤 색을 좋아해요?"],["她很喜欢猫。","그녀는 고양이를 아주 좋아해요."],["我不太喜欢下雨天。","저는 비 오는 날을 별로 좋아하지 않아요."]]},{"word":"想","pinyin":"xiǎng","meaning":"생각하다, ~하고 싶다","nuance":"생각하거나 희망·의도를 나타낼 때 자주 씁니다.","examples":[["我想喝咖啡。","커피 마시고 싶어요."],["你在想什么？","무슨 생각을 하고 있어요?"],["我想去中国旅行。","저는 중국 여행을 가고 싶어요."],["让我想一想。","생각 좀 해볼게요."]]}]