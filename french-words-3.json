[{"word":"arriver","ipa":"/a.ʁi.ve/","meaning":"도착하다","nuance":"목적지에 도착하거나 일이 발생할 때 씁니다.","examples":[["J'arrive dans dix minutes.","10분 뒤에 도착해요."],["Nous sommes arrivés à Paris.","우리는 파리에 도착했어요."],["Le train arrive à huit heures.","기차는 8시에 도착해요."],["Qu'est-ce qui est arrivé ?","무슨 일이 있었어요?"]]},{"word":"habiter","ipa":"/a.bi.te/","meaning":"살다, 거주하다","nuance":"사는 장소를 말할 때 씁니다.","examples":[["J'habite à Séoul.","저는 서울에 살아요."],["Où est-ce que tu habites ?","어디에 살아요?"],["Nous habitons près du centre.","우리는 중심가 근처에 살아요."],["Elle habite seule.","그녀는 혼자 살아요."]]},{"word":"aimer","ipa":"/e.me/","meaning":"좋아하다, 사랑하다","nuance":"사람·사물·활동을 좋아할 때 씁니다.","examples":[["J'aime ce quartier.","저는 이 동네를 좋아해요."],["Nous aimons voyager.","우리는 여행을 좋아해요."],["Tu aimes le chocolat ?","초콜릿 좋아해요?"],["Elle aime beaucoup son travail.","그녀는 자기 일을 아주 좋아해요."]]},{"word":"préférer","ipa":"/pʁe.fe.ʁe/","meaning":"더 좋아하다, 선호하다","nuance":"두 선택지 중 선호를 표현합니다.","examples":[["Je préfère le thé.","저는 차를 더 좋아해요."],["Tu préfères rester ici ?","여기 있는 게 더 좋아요?"],["Nous préférons partir tôt.","우리는 일찍 떠나는 걸 선호해요."],["Elle préfère travailler seule.","그녀는 혼자 일하는 걸 더 좋아해요."]]},{"word":"commencer","ipa":"/kɔ.mɑ̃.se/","meaning":"시작하다","nuance":"일이나 행동이 시작될 때 씁니다.","examples":[["Le cours commence à neuf heures.","수업은 9시에 시작해요."],["Je commence demain.","저는 내일 시작해요."],["Nous commençons par le plus important.","우리는 가장 중요한 것부터 시작해요."],["Il commence à pleuvoir.","비가 오기 시작해요."]]},{"word":"finir","ipa":"/fi.niʁ/","meaning":"끝내다, 끝나다","nuance":"일이나 행동을 마칠 때 씁니다.","examples":[["Je finis à six heures.","저는 6시에 끝나요."],["Nous avons fini le projet.","우리는 프로젝트를 끝냈어요."],["Finis ton café.","커피 마저 마셔요."],["Le film finit tard.","영화가 늦게 끝나요."]]},{"word":"ouvrir","ipa":"/u.vʁiʁ/","meaning":"열다","nuance":"문·창문·가게 등을 열 때 씁니다.","examples":[["Ouvrez la porte, s'il vous plaît.","문을 열어 주세요."],["Le magasin ouvre à dix heures.","가게는 10시에 열어요."],["J'ouvre la fenêtre.","저는 창문을 열어요."],["Elle a ouvert son cadeau.","그녀는 선물을 열었어요."]]},{"word":"fermer","ipa":"/fɛʁ.me/","meaning":"닫다","nuance":"문·창문·가게 등을 닫을 때 씁니다.","examples":[["Fermez la porte, s'il vous plaît.","문을 닫아 주세요."],["Le magasin ferme à neuf heures.","가게는 9시에 닫아요."],["Je ferme la fenêtre.","저는 창문을 닫아요."],["La banque est déjà fermée.","은행은 이미 문을 닫았어요."]]},{"word":"aider","ipa":"/e.de/","meaning":"돕다","nuance":"누군가에게 도움을 줄 때 씁니다.","examples":[["Je peux vous aider ?","도와드릴까요?"],["Merci de m'aider.","도와줘서 고마워요."],["Nous aidons un ami.","우리는 친구 한 명을 도와요."],["Elle m'aide beaucoup.","그녀는 저를 많이 도와줘요."]]},{"word":"demander","ipa":"/də.mɑ̃.de/","meaning":"묻다, 요청하다","nuance":"질문하거나 부탁할 때 씁니다.","examples":[["Je voudrais demander quelque chose.","무언가 물어보고 싶어요."],["Demande-lui son adresse.","그에게 주소를 물어봐요."],["Nous avons demandé de l'aide.","우리는 도움을 요청했어요."],["Elle demande un café.","그녀는 커피를 주문해요."]]},{"word":"répondre","ipa":"/ʁe.pɔ̃dʁ/","meaning":"대답하다","nuance":"질문이나 메시지에 답할 때 씁니다.","examples":[["Je vais répondre à votre question.","질문에 답할게요."],["Réponds-moi, s'il te plaît.","답해 주세요."],["Nous avons répondu au message.","우리는 메시지에 답했어요."],["Elle répond toujours vite.","그녀는 항상 빨리 답해요."]]},{"word":"aujourd'hui","ipa":"/o.ʒuʁ.dɥi/","meaning":"오늘","nuance":"현재 날짜를 나타내는 기본 시간 표현입니다.","examples":[["Aujourd'hui, je travaille à la maison.","오늘 저는 집에서 일해요."],["Il fait beau aujourd'hui.","오늘 날씨가 좋아요."],["Tu es libre aujourd'hui ?","오늘 시간 있어요?"],["Aujourd'hui est une journée importante.","오늘은 중요한 날이에요."]]},{"word":"demain","ipa":"/də.mɛ̃/","meaning":"내일","nuance":"오늘의 다음 날을 뜻합니다.","examples":[["À demain !","내일 봐요!"],["Je pars demain matin.","저는 내일 아침에 떠나요."],["Nous travaillerons demain.","우리는 내일 일할 거예요."],["Demain, il va pleuvoir.","내일 비가 올 거예요."]]},{"word":"hier","ipa":"/jɛʁ/","meaning":"어제","nuance":"오늘의 전날을 뜻합니다.","examples":[["Hier, j'étais très occupé.","어제 저는 매우 바빴어요."],["Nous avons vu ce film hier.","우리는 어제 이 영화를 봤어요."],["Hier, il a plu toute la journée.","어제 하루 종일 비가 왔어요."],["Je l'ai appelé hier soir.","저는 어젯밤 그에게 전화했어요."]]},{"word":"maintenant","ipa":"/mɛ̃.tə.nɑ̃/","meaning":"지금","nuance":"현재 시점을 나타냅니다.","examples":[["Je dois partir maintenant.","저는 지금 가야 해요."],["On commence maintenant ?","지금 시작할까요?"],["Il est occupé maintenant.","그는 지금 바빠요."],["Maintenant, je comprends.","이제 이해해요."]]},{"word":"bientôt","ipa":"/bjɛ̃.to/","meaning":"곧","nuance":"가까운 미래를 나타냅니다.","examples":[["À bientôt !","곧 다시 봐요!"],["Le train arrive bientôt.","기차가 곧 도착해요."],["Je vais bientôt partir.","저는 곧 떠날 거예요."],["On se voit bientôt.","우리 곧 봐요."]]},{"word":"toujours","ipa":"/tu.ʒuʁ/","meaning":"항상","nuance":"행동이나 상태가 계속됨을 나타냅니다.","examples":[["Il est toujours à l'heure.","그는 항상 제시간에 와요."],["Je prends toujours un café le matin.","저는 아침에 항상 커피를 마셔요."],["Elle travaille toujours ici.","그녀는 아직도 여기서 일해요."],["Tu es toujours gentil.","당신은 늘 친절해요."]]},{"word":"souvent","ipa":"/su.vɑ̃/","meaning":"자주","nuance":"빈도가 높은 행동을 나타냅니다.","examples":[["Je vais souvent au café.","저는 카페에 자주 가요."],["Nous voyageons souvent en train.","우리는 기차로 자주 여행해요."],["Il appelle souvent sa famille.","그는 가족에게 자주 전화해요."],["Elle cuisine souvent le week-end.","그녀는 주말에 자주 요리해요."]]},{"word":"parfois","ipa":"/paʁ.fwa/","meaning":"가끔","nuance":"가끔 일어나는 행동을 나타냅니다.","examples":[["Je travaille parfois le samedi.","저는 가끔 토요일에 일해요."],["Il pleut parfois en été.","여름에는 가끔 비가 와요."],["Nous mangeons parfois dehors.","우리는 가끔 밖에서 먹어요."],["Elle est parfois très calme.","그녀는 가끔 아주 조용해요."]]},{"word":"jamais","ipa":"/ʒa.mɛ/","meaning":"절대 ~않다, 한 번도 ~않다","nuance":"부정문에서 ‘결코’라는 뜻으로 자주 씁니다.","examples":[["Je ne bois jamais de café le soir.","저는 저녁에 커피를 절대 마시지 않아요."],["Il n'est jamais en retard.","그는 절대 늦지 않아요."],["Nous ne sommes jamais allés là-bas.","우리는 거기에 한 번도 가본 적이 없어요."],["Elle ne regarde jamais la télévision.","그녀는 TV를 전혀 보지 않아요."]]}]