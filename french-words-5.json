[{"word":"la famille","ipa":"/la fa.mij/","meaning":"가족","nuance":"가족 전체를 뜻합니다.","examples":[["Ma famille habite en Corée.","제 가족은 한국에 살아요."],["Je passe le week-end avec ma famille.","저는 주말을 가족과 보내요."],["Nous parlons souvent de notre famille.","우리는 가족 이야기를 자주 해요."],["Sa famille est très gentille.","그의 가족은 아주 친절해요."]]},{"word":"un ami","ipa":"/œ̃n a.mi/","meaning":"남자 친구, 친구","nuance":"친구 한 명을 뜻합니다.","examples":[["C'est un ami de travail.","직장 친구예요."],["Je vais voir un ami ce soir.","오늘 저녁 친구를 만나러 가요."],["Un ami m'a recommandé ce café.","친구가 이 카페를 추천해줬어요."],["J'attends un ami devant la gare.","저는 역 앞에서 친구를 기다리고 있어요."]]},{"word":"une amie","ipa":"/yn a.mi/","meaning":"여자 친구, 친구","nuance":"여성 친구 한 명을 뜻합니다.","examples":[["C'est une amie française.","프랑스인 여자 친구예요."],["Je déjeune avec une amie.","저는 여자 친구와 점심을 먹어요."],["Une amie m'a appelé hier.","여자 친구가 어제 저에게 전화했어요."],["Je voyage avec une amie.","저는 여자 친구와 여행해요."]]},{"word":"beau","ipa":"/bo/","meaning":"아름다운, 좋은","nuance":"남성 명사 앞에서 아름다움·좋음을 나타냅니다.","examples":[["C'est un beau quartier.","아름다운 동네예요."],["Il fait beau aujourd'hui.","오늘 날씨가 좋아요."],["Quel beau cadeau !","정말 멋진 선물이네요!"],["Nous avons une belle vue.","우리는 멋진 전망을 가지고 있어요."]]},{"word":"bon","ipa":"/bɔ̃/","meaning":"좋은, 맛있는","nuance":"품질·상태·맛 등이 좋음을 나타냅니다.","examples":[["C'est un bon restaurant.","좋은 식당이에요."],["Ce gâteau est très bon.","이 케이크는 아주 맛있어요."],["Bonne idée !","좋은 생각이에요!"],["Il a un bon travail.","그는 좋은 직장이 있어요."]]},{"word":"mauvais","ipa":"/mo.vɛ/","meaning":"나쁜","nuance":"품질이나 상황이 좋지 않음을 나타냅니다.","examples":[["C'est une mauvaise idée.","나쁜 생각이에요."],["Le temps est mauvais aujourd'hui.","오늘 날씨가 나빠요."],["J'ai une mauvaise nouvelle.","나쁜 소식이 있어요."],["Ce café n'est pas mauvais.","이 커피는 나쁘지 않아요."]]},{"word":"grand","ipa":"/ɡʁɑ̃/","meaning":"큰, 키가 큰","nuance":"크기·규모·키가 큼을 나타냅니다.","examples":[["Paris est une grande ville.","파리는 큰 도시예요."],["Il est très grand.","그는 키가 아주 커요."],["Nous avons une grande table.","우리는 큰 테이블이 있어요."],["C'est un grand changement.","큰 변화예요."]]},{"word":"petit","ipa":"/pə.ti/","meaning":"작은","nuance":"크기·규모가 작음을 나타냅니다.","examples":[["J'habite dans un petit appartement.","저는 작은 아파트에 살아요."],["Je voudrais un petit café.","작은 커피 한 잔 주세요."],["C'est un petit problème.","작은 문제예요."],["Nous avons une petite voiture.","우리는 작은 차가 있어요."]]},{"word":"nouveau","ipa":"/nu.vo/","meaning":"새로운","nuance":"새로 생기거나 새롭게 시작된 것을 말합니다.","examples":[["J'ai un nouveau travail.","저는 새 직장이 있어요."],["C'est un nouveau café.","새 카페예요."],["Nous apprenons un nouveau mot.","우리는 새 단어를 배워요."],["Elle a un nouvel appartement.","그녀는 새 아파트가 있어요."]]},{"word":"vieux","ipa":"/vjø/","meaning":"오래된, 나이 든","nuance":"오래되었거나 나이가 많음을 나타냅니다.","examples":[["C'est un vieux bâtiment.","오래된 건물이에요."],["Mon ordinateur est vieux.","제 컴퓨터는 오래됐어요."],["Il habite dans une vieille maison.","그는 오래된 집에 살아요."],["Ce livre est très vieux.","이 책은 아주 오래됐어요."]]},{"word":"facile","ipa":"/fa.sil/","meaning":"쉬운","nuance":"하기 어렵지 않은 것을 뜻합니다.","examples":[["Cet exercice est facile.","이 연습문제는 쉬워요."],["C'est facile à comprendre.","이해하기 쉬워요."],["La gare est facile à trouver.","역은 찾기 쉬워요."],["Parler est plus facile avec de la pratique.","연습하면 말하기가 더 쉬워져요."]]},{"word":"difficile","ipa":"/di.fi.sil/","meaning":"어려운","nuance":"하기 힘들거나 복잡한 것을 뜻합니다.","examples":[["Cette question est difficile.","이 질문은 어려워요."],["C'est difficile à expliquer.","설명하기 어려워요."],["Le français est parfois difficile.","프랑스어는 가끔 어려워요."],["Trouver un appartement est difficile ici.","여기서는 아파트 찾기가 어려워요."]]},{"word":"important","ipa":"/ɛ̃.pɔʁ.tɑ̃/","meaning":"중요한","nuance":"가치나 영향이 큰 것을 나타냅니다.","examples":[["C'est très important.","이건 매우 중요해요."],["Le sommeil est important.","수면은 중요해요."],["Nous avons une réunion importante.","우리는 중요한 회의가 있어요."],["Ce détail est important pour le projet.","이 디테일은 프로젝트에 중요해요."]]},{"word":"intéressant","ipa":"/ɛ̃.te.ʁe.sɑ̃/","meaning":"흥미로운","nuance":"관심을 끌고 생각할 거리가 있는 것을 말합니다.","examples":[["Ce livre est intéressant.","이 책은 흥미로워요."],["Je trouve ce sujet intéressant.","저는 이 주제가 흥미롭다고 생각해요."],["La discussion était intéressante.","대화가 흥미로웠어요."],["C'est une idée intéressante.","흥미로운 아이디어예요."]]},{"word":"cher","ipa":"/ʃɛʁ/","meaning":"비싼","nuance":"가격이 높은 것을 나타냅니다.","examples":[["Ce sac est trop cher.","이 가방은 너무 비싸요."],["Le restaurant est un peu cher.","이 식당은 조금 비싸요."],["C'est cher à Paris.","파리는 물가가 비싸요."],["Je cherche quelque chose de moins cher.","좀 더 싼 것을 찾고 있어요."]]},{"word":"bon marché","ipa":"/bɔ̃ maʁ.ʃe/","meaning":"저렴한","nuance":"가격이 비교적 싼 것을 나타냅니다.","examples":[["Ce café est bon marché.","이 카페는 저렴해요."],["Je cherche un hôtel bon marché.","저렴한 호텔을 찾고 있어요."],["Les billets sont bon marché aujourd'hui.","오늘 표가 저렴해요."],["C'est simple et bon marché.","간단하고 저렴해요."]]},{"word":"rapide","ipa":"/ʁa.pid/","meaning":"빠른","nuance":"속도가 빠른 것을 나타냅니다.","examples":[["Le train est rapide.","기차는 빨라요."],["C'est une solution rapide.","빠른 해결책이에요."],["Elle apprend très rapidement.","그녀는 아주 빠르게 배워요."],["Le service est rapide ici.","여기 서비스는 빨라요."]]},{"word":"lent","ipa":"/lɑ̃/","meaning":"느린","nuance":"속도가 느린 것을 나타냅니다.","examples":[["Le bus est lent aujourd'hui.","오늘 버스가 느려요."],["Mon ordinateur est très lent.","제 컴퓨터가 아주 느려요."],["Parlez plus lentement, s'il vous plaît.","조금 천천히 말해 주세요."],["Le service était un peu lent.","서비스가 조금 느렸어요."]]},{"word":"occupé","ipa":"/ɔ.ky.pe/","meaning":"바쁜","nuance":"시간이 없을 정도로 일이 많은 상태입니다.","examples":[["Je suis occupé aujourd'hui.","저는 오늘 바빠요."],["Tu es occupé ce soir ?","오늘 저녁 바빠요?"],["Elle est très occupée cette semaine.","그녀는 이번 주에 아주 바빠요."],["Désolé, je suis occupé maintenant.","미안하지만 지금 바빠요."]]},{"word":"fatigué","ipa":"/fa.ti.ɡe/","meaning":"피곤한","nuance":"몸이나 정신이 지친 상태를 말합니다.","examples":[["Je suis fatigué.","저는 피곤해요."],["Nous sommes fatigués après le voyage.","우리는 여행 후 피곤해요."],["Elle a l'air fatiguée.","그녀는 피곤해 보여요."],["Quand je suis fatigué, je me repose.","피곤할 때 저는 쉬어요."]]}]