[{"word":"手机","pinyin":"shǒu jī","meaning":"휴대전화, 휴대폰","nuance":"일상에서 스마트폰을 포함한 휴대전화를 가장 일반적으로 가리키는 말입니다.","examples":[["我的手机没电了。","제 휴대폰 배터리가 다 됐어요."],["你可以用手机付款。","휴대폰으로 결제할 수 있어요."],["我把手机忘在家里了。","휴대폰을 집에 두고 왔어요."],["请把手机调成静音。","휴대폰을 무음으로 설정해 주세요."]]},{"word":"地铁","pinyin":"dì tiě","meaning":"지하철","nuance":"도시의 지하철 교통수단을 뜻하며 이동 관련 회화에서 매우 자주 씁니다.","examples":[["我每天坐地铁上班。","저는 매일 지하철을 타고 출근해요."],["地铁站离这里远吗？","지하철역이 여기서 멀어요?"],["我们坐地铁去吧。","우리 지하철 타고 가요."],["这条地铁线很方便。","이 지하철 노선은 매우 편리해요."]]},{"word":"机场","pinyin":"jī chǎng","meaning":"공항","nuance":"비행기를 타거나 내리는 공항을 뜻하는 기본 여행 어휘입니다.","examples":[["我下午去机场。","저는 오후에 공항에 가요."],["从这里到机场要多久？","여기서 공항까지 얼마나 걸려요?"],["他在机场等朋友。","그는 공항에서 친구를 기다리고 있어요."],["我们提前两个小时到机场。","우리는 두 시간 일찍 공항에 도착해요."]]},{"word":"房间","pinyin":"fáng jiān","meaning":"방, 객실","nuance":"집 안의 방뿐 아니라 호텔 객실을 말할 때도 자주 씁니다.","examples":[["这个房间很安静。","이 방은 매우 조용해요."],["我的房间在三楼。","제 방은 3층에 있어요."],["酒店还有空房间吗？","호텔에 빈 객실이 있나요?"],["请帮我打扫房间。","방 청소를 부탁드려요."]]},{"word":"附近","pinyin":"fù jìn","meaning":"근처, 부근","nuance":"어떤 장소와 가까운 주변 지역을 말할 때 쓰는 실용적인 위치 표현입니다.","examples":[["这附近有便利店吗？","이 근처에 편의점이 있나요?"],["我住在公司附近。","저는 회사 근처에 살아요."],["附近有一家不错的餐厅。","근처에 괜찮은 식당이 하나 있어요."],["我们在车站附近见吧。","우리 역 근처에서 만나요."]]},{"word":"迟到","pinyin":"chí dào","meaning":"지각하다, 늦다","nuance":"약속·수업·출근 등에 정해진 시간보다 늦게 도착할 때 씁니다.","examples":[["对不起，我迟到了。","미안해요, 제가 늦었어요."],["他今天上班迟到了。","그는 오늘 출근에 지각했어요."],["别迟到，我们八点出发。","늦지 마세요, 우리는 8시에 출발해요."],["因为堵车，我迟到了十分钟。","차가 막혀서 10분 늦었어요."]]},{"word":"预约","pinyin":"yù yuē","meaning":"예약하다, 예약","nuance":"병원·식당·서비스 등의 시간이나 자리를 미리 잡을 때 자주 씁니다.","examples":[["我想预约明天下午。","내일 오후로 예약하고 싶어요."],["看医生需要提前预约吗？","진료받으려면 미리 예약해야 하나요?"],["我已经预约了两个人的位置。","두 사람 자리를 이미 예약했어요."],["请问可以网上预约吗？","온라인으로 예약할 수 있나요?"]]},{"word":"方便","pinyin":"fāng biàn","meaning":"편리하다, 편하다","nuance":"교통·시간·사용성 등이 편리한 상태를 말하며, 상대에게 시간이 괜찮은지 물을 때도 씁니다.","examples":[["这里交通很方便。","여기는 교통이 매우 편리해요."],["你现在方便说话吗？","지금 통화하기 괜찮아요?"],["用手机付款很方便。","휴대폰으로 결제하면 매우 편리해요."],["如果方便的话，请给我打电话。","괜찮으시면 저에게 전화해 주세요."]]},{"word":"问题","pinyin":"wèn tí","meaning":"문제, 질문","nuance":"해결해야 할 문제와 묻고 싶은 질문을 모두 가리킬 수 있는 매우 기본적인 명사입니다.","examples":[["我有一个问题。","질문이 하나 있어요."],["这个问题不太难。","이 문제는 그다지 어렵지 않아요."],["有什么问题可以问老师。","질문이 있으면 선생님께 물어봐도 돼요."],["我们一起解决这个问题吧。","우리 함께 이 문제를 해결해 봐요."]]},{"word":"票","pinyin":"piào","meaning":"표, 티켓","nuance":"기차·비행기·영화·공연 등 입장이나 이동에 필요한 표를 뜻합니다.","examples":[["我想买两张票。","표 두 장 사고 싶어요."],["你的票在哪里？","당신 표는 어디에 있어요?"],["火车票已经卖完了。","기차표가 이미 매진됐어요."],["这张票多少钱？","이 표는 얼마예요?"]]}]