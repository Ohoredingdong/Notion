[{"word":"faire","ipa":"/fɛʁ/","meaning":"하다, 만들다","nuance":"활용 범위가 매우 넓은 핵심 동사입니다.","examples":[["Je fais du sport le matin.","저는 아침에 운동해요."],["Qu'est-ce que tu fais ?","뭐 하고 있어요?"],["Il fait froid aujourd'hui.","오늘은 추워요."],["Nous faisons un gâteau.","우리는 케이크를 만들어요."]]},{"word":"pouvoir","ipa":"/pu.vwaʁ/","meaning":"~할 수 있다","nuance":"가능·허가를 나타내는 핵심 동사입니다.","examples":[["Je peux vous aider.","제가 도와드릴 수 있어요."],["On peut entrer ?","들어가도 돼요?"],["Tu peux répéter ?","다시 말해줄 수 있어요?"],["Je ne peux pas venir demain.","저는 내일 올 수 없어요."]]},{"word":"vouloir","ipa":"/vu.lwaʁ/","meaning":"원하다","nuance":"희망·의지를 나타내며 주문에도 자주 쓰입니다.","examples":[["Je veux apprendre le français.","저는 프랑스어를 배우고 싶어요."],["Tu veux un café ?","커피 마실래요?"],["Nous voulons partir tôt.","우리는 일찍 떠나고 싶어요."],["Elle veut changer de travail.","그녀는 직장을 바꾸고 싶어 해요."]]},{"word":"devoir","ipa":"/də.vwaʁ/","meaning":"~해야 하다","nuance":"의무·필요를 나타냅니다.","examples":[["Je dois travailler demain.","저는 내일 일해야 해요."],["Nous devons partir maintenant.","우리는 지금 떠나야 해요."],["Tu dois faire attention.","조심해야 해요."],["Il doit appeler sa mère.","그는 어머니께 전화해야 해요."]]},{"word":"savoir","ipa":"/sa.vwaʁ/","meaning":"알다, 할 줄 알다","nuance":"사실·방법·능력을 안다는 뜻입니다.","examples":[["Je sais nager.","저는 수영할 줄 알아요."],["Tu sais où il est ?","그가 어디 있는지 알아요?"],["Nous savons la vérité.","우리는 진실을 알아요."],["Elle sait bien cuisiner.","그녀는 요리를 잘해요."]]},{"word":"parler","ipa":"/paʁ.le/","meaning":"말하다","nuance":"언어를 말하거나 대화할 때 씁니다.","examples":[["Je parle un peu français.","저는 프랑스어를 조금 해요."],["Nous parlons de notre projet.","우리는 프로젝트에 대해 이야기해요."],["Parlez plus lentement, s'il vous plaît.","조금 천천히 말해 주세요."],["Il parle avec son collègue.","그는 동료와 이야기하고 있어요."]]},{"word":"écouter","ipa":"/e.ku.te/","meaning":"듣다","nuance":"의식적으로 소리를 듣는 동작입니다.","examples":[["J'écoute de la musique.","저는 음악을 들어요."],["Écoutez bien, s'il vous plaît.","잘 들어 주세요."],["Nous écoutons les informations.","우리는 뉴스를 들어요."],["Elle aime écouter la radio.","그녀는 라디오 듣는 걸 좋아해요."]]},{"word":"regarder","ipa":"/ʁə.ɡaʁ.de/","meaning":"보다","nuance":"의식적으로 바라보거나 시청할 때 씁니다.","examples":[["Je regarde un film.","저는 영화를 보고 있어요."],["Regarde cette photo.","이 사진을 봐요."],["Nous regardons la télévision.","우리는 TV를 봐요."],["Elle aime regarder les gens passer.","그녀는 지나가는 사람들을 보는 걸 좋아해요."]]},{"word":"lire","ipa":"/liʁ/","meaning":"읽다","nuance":"책·문서·메시지를 읽을 때 씁니다.","examples":[["Je lis un livre.","저는 책을 읽어요."],["Tu peux lire ce message ?","이 메시지를 읽어줄 수 있어요?"],["Nous lisons le journal le matin.","우리는 아침에 신문을 읽어요."],["Elle aime lire au café.","그녀는 카페에서 독서하는 걸 좋아해요."]]},{"word":"écrire","ipa":"/e.kʁiʁ/","meaning":"쓰다","nuance":"글·메시지·이메일 등을 작성할 때 씁니다.","examples":[["J'écris un e-mail.","저는 이메일을 쓰고 있어요."],["Écris ton nom ici.","여기에 이름을 써요."],["Nous écrivons une carte.","우리는 카드를 쓰고 있어요."],["Elle aime écrire le soir.","그녀는 저녁에 글 쓰는 걸 좋아해요."]]},{"word":"apprendre","ipa":"/a.pʁɑ̃dʁ/","meaning":"배우다","nuance":"새로운 지식이나 기술을 익힐 때 씁니다.","examples":[["J'apprends le français.","저는 프랑스어를 배우고 있어요."],["Nous apprenons de nouveaux mots.","우리는 새 단어들을 배워요."],["Il apprend vite.","그는 빨리 배워요."],["J'aime apprendre quelque chose chaque jour.","저는 매일 무언가 배우는 걸 좋아해요."]]},{"word":"travailler","ipa":"/tʁa.va.je/","meaning":"일하다","nuance":"직장 업무나 공부에 힘쓸 때 쓰입니다.","examples":[["Je travaille à Séoul.","저는 서울에서 일해요."],["Nous travaillons ensemble.","우리는 함께 일해요."],["Il travaille beaucoup cette semaine.","그는 이번 주에 일을 많이 해요."],["Je dois travailler demain.","저는 내일 일해야 해요."]]},{"word":"manger","ipa":"/mɑ̃.ʒe/","meaning":"먹다","nuance":"음식을 먹는 동작입니다.","examples":[["Je mange à midi.","저는 정오에 밥을 먹어요."],["Nous allons manger ensemble.","우리 같이 밥 먹으러 가요."],["Elle mange beaucoup de légumes.","그녀는 채소를 많이 먹어요."],["Tu veux manger quelque chose ?","뭐 좀 먹을래요?"]]},{"word":"boire","ipa":"/bwaʁ/","meaning":"마시다","nuance":"음료를 마실 때 씁니다.","examples":[["Je bois de l'eau.","저는 물을 마셔요."],["Nous buvons du café le matin.","우리는 아침에 커피를 마셔요."],["Tu veux boire quelque chose ?","뭐 좀 마실래요?"],["Elle ne boit pas d'alcool.","그녀는 술을 마시지 않아요."]]},{"word":"acheter","ipa":"/aʃ.te/","meaning":"사다","nuance":"물건이나 서비스를 구매할 때 씁니다.","examples":[["Je vais acheter du pain.","저는 빵을 사러 갈 거예요."],["Nous achetons des billets en ligne.","우리는 온라인으로 표를 사요."],["Tu as acheté cette veste où ?","이 재킷 어디서 샀어요?"],["Elle veut acheter un cadeau.","그녀는 선물을 사고 싶어 해요."]]},{"word":"payer","ipa":"/pe.je/","meaning":"지불하다","nuance":"가격이나 비용을 낼 때 씁니다.","examples":[["Je peux payer par carte ?","카드로 결제해도 돼요?"],["Nous payons l'addition.","우리는 계산을 해요."],["Qui va payer ?","누가 계산할 거예요?"],["J'ai déjà payé.","저는 이미 결제했어요."]]},{"word":"chercher","ipa":"/ʃɛʁ.ʃe/","meaning":"찾다","nuance":"사람·물건·정보를 찾을 때 씁니다.","examples":[["Je cherche mes clés.","저는 열쇠를 찾고 있어요."],["Nous cherchons un restaurant.","우리는 식당을 찾고 있어요."],["Que cherchez-vous ?","무엇을 찾으세요?"],["Elle cherche un nouvel appartement.","그녀는 새 아파트를 찾고 있어요."]]},{"word":"trouver","ipa":"/tʁu.ve/","meaning":"찾다, 발견하다, 생각하다","nuance":"무언가를 발견하거나 의견을 말할 때도 씁니다.","examples":[["J'ai trouvé mes clés.","열쇠를 찾았어요."],["Nous avons trouvé un bon café.","우리는 좋은 카페를 찾았어요."],["Je trouve ce film intéressant.","저는 이 영화가 흥미롭다고 생각해요."],["Tu trouves ça comment ?","이거 어떻게 생각해요?"]]},{"word":"attendre","ipa":"/a.tɑ̃dʁ/","meaning":"기다리다","nuance":"사람이나 시간을 기다릴 때 씁니다.","examples":[["J'attends le bus.","저는 버스를 기다리고 있어요."],["Attendez une minute, s'il vous plaît.","1분만 기다려 주세요."],["Nous attendons nos amis.","우리는 친구들을 기다리고 있어요."],["Elle m'attend devant la gare.","그녀는 역 앞에서 저를 기다리고 있어요."]]},{"word":"partir","ipa":"/paʁ.tiʁ/","meaning":"떠나다","nuance":"장소를 떠나거나 출발할 때 씁니다.","examples":[["Je pars demain matin.","저는 내일 아침에 떠나요."],["Nous devons partir maintenant.","우리는 지금 떠나야 해요."],["Le train part à neuf heures.","기차는 9시에 출발해요."],["Elle est partie tôt.","그녀는 일찍 떠났어요."]]}]