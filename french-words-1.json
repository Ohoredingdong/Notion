[{"word":"bonjour","ipa":"/bɔ̃.ʒuʁ/","meaning":"안녕하세요","nuance":"가장 기본적인 낮 인사입니다.","examples":[["Bonjour, comment allez-vous ?","안녕하세요, 잘 지내세요?"],["Bonjour, je m'appelle Léa.","안녕하세요, 저는 레아예요."],["Bonjour à tous !","여러분 안녕하세요!"],["Bonjour, je peux vous aider ?","안녕하세요, 도와드릴까요?"]]},{"word":"merci","ipa":"/mɛʁ.si/","meaning":"감사합니다","nuance":"감사를 표현할 때 가장 자주 쓰는 말입니다.","examples":[["Merci pour votre aide.","도와주셔서 감사합니다."],["Merci beaucoup !","정말 감사합니다!"],["Merci d'être venu.","와주셔서 감사합니다."],["Merci, c'est gentil.","고마워요, 친절하시네요."]]},{"word":"s'il vous plaît","ipa":"/sil vu plɛ/","meaning":"부탁합니다, 주세요","nuance":"정중한 부탁이나 주문에 붙입니다.","examples":[["Un café, s'il vous plaît.","커피 한 잔 주세요."],["Parlez plus lentement, s'il vous plaît.","조금 천천히 말해 주세요."],["Attendez ici, s'il vous plaît.","여기서 기다려 주세요."],["L'addition, s'il vous plaît.","계산서 주세요."]]},{"word":"au revoir","ipa":"/o ʁə.vwaʁ/","meaning":"안녕히 가세요, 또 봐요","nuance":"헤어질 때 쓰는 기본 인사입니다.","examples":[["Au revoir, à demain !","안녕, 내일 봐요!"],["Merci et au revoir.","감사합니다, 안녕히 가세요."],["Au revoir, bonne journée !","안녕히 가세요, 좋은 하루 보내세요!"],["Je dois partir. Au revoir !","저 이제 가야 해요. 안녕히 계세요!"]]},{"word":"oui","ipa":"/wi/","meaning":"네","nuance":"긍정의 가장 기본적인 대답입니다.","examples":[["Oui, bien sûr.","네, 물론이죠."],["Oui, je comprends.","네, 이해해요."],["Oui, c'est possible.","네, 가능해요."],["Oui, je suis prêt.","네, 준비됐어요."]]},{"word":"non","ipa":"/nɔ̃/","meaning":"아니요","nuance":"부정의 가장 기본적인 대답입니다.","examples":[["Non, merci.","아니요, 괜찮아요."],["Non, je ne sais pas.","아니요, 저는 몰라요."],["Non, ce n'est pas loin.","아니요, 멀지 않아요."],["Non, pas aujourd'hui.","아니요, 오늘은 아니에요."]]},{"word":"peut-être","ipa":"/pø.t‿ɛtʁ/","meaning":"아마, 어쩌면","nuance":"확실하지 않은 가능성을 말합니다.","examples":[["Peut-être demain.","아마 내일일 거예요."],["Il viendra peut-être ce soir.","그는 아마 오늘 저녁에 올 거예요."],["Peut-être que tu as raison.","네 말이 맞을지도 몰라요."],["Je vais peut-être rester ici.","저는 아마 여기 남을 것 같아요."]]},{"word":"d'accord","ipa":"/da.kɔʁ/","meaning":"좋아요, 알겠어요","nuance":"동의하거나 이해했음을 나타냅니다.","examples":[["D'accord, on y va.","좋아요, 가죠."],["D'accord, je comprends.","알겠어요, 이해했어요."],["Tu es d'accord ?","동의해요?"],["D'accord, à demain.","좋아요, 내일 봐요."]]},{"word":"excusez-moi","ipa":"/ɛk.sky.ze mwa/","meaning":"실례합니다, 죄송합니다","nuance":"주의를 끌거나 가볍게 사과할 때 씁니다.","examples":[["Excusez-moi, où est la gare ?","실례합니다, 역이 어디예요?"],["Excusez-moi, je suis en retard.","죄송해요, 제가 늦었어요."],["Excusez-moi, je n'ai pas compris.","죄송하지만 이해하지 못했어요."],["Excusez-moi, vous avez l'heure ?","실례합니다, 지금 몇 시인지 아세요?"]]},{"word":"pardon","ipa":"/paʁ.dɔ̃/","meaning":"미안해요, 뭐라고요?","nuance":"사과하거나 못 들었을 때 되묻는 표현입니다.","examples":[["Pardon, je vous ai bousculé.","죄송해요, 제가 부딪쳤네요."],["Pardon ? Vous pouvez répéter ?","뭐라고요? 다시 말해주실래요?"],["Pardon pour le retard.","늦어서 미안해요."],["Oh, pardon !","아, 죄송해요!"]]},{"word":"je voudrais","ipa":"/ʒə vu.dʁɛ/","meaning":"~을 원합니다","nuance":"주문이나 요청을 정중하게 말할 때 유용합니다.","examples":[["Je voudrais un café.","커피 한 잔 주세요."],["Je voudrais réserver une table.","테이블을 예약하고 싶어요."],["Je voudrais essayer cette veste.","이 재킷을 입어보고 싶어요."],["Je voudrais plus d'informations.","정보를 좀 더 알고 싶어요."]]},{"word":"j'aime","ipa":"/ʒɛm/","meaning":"저는 ~을 좋아해요","nuance":"좋아하는 대상이나 활동을 말할 때 씁니다.","examples":[["J'aime le café.","저는 커피를 좋아해요."],["J'aime lire le soir.","저는 저녁에 독서하는 걸 좋아해요."],["J'aime cette couleur.","저는 이 색을 좋아해요."],["J'aime voyager en train.","저는 기차 여행을 좋아해요."]]},{"word":"je pense","ipa":"/ʒə pɑ̃s/","meaning":"저는 생각해요","nuance":"의견이나 판단을 부드럽게 표현합니다.","examples":[["Je pense que c'est une bonne idée.","좋은 생각이라고 생각해요."],["Je pense à mes vacances.","휴가를 생각하고 있어요."],["Je pense qu'il va pleuvoir.","비가 올 것 같아요."],["Je pense la même chose.","저도 같은 생각이에요."]]},{"word":"je sais","ipa":"/ʒə sɛ/","meaning":"저는 알아요","nuance":"사실이나 방법을 알고 있다고 말합니다.","examples":[["Je sais où il habite.","그가 어디 사는지 알아요."],["Je sais comment faire.","어떻게 하는지 알아요."],["Je sais que tu es occupé.","네가 바쁜 걸 알아요."],["Je ne sais pas encore.","아직 모르겠어요."]]},{"word":"je comprends","ipa":"/ʒə kɔ̃.pʁɑ̃/","meaning":"이해해요","nuance":"말이나 상황을 이해했음을 나타냅니다.","examples":[["Je comprends la question.","질문을 이해해요."],["Je comprends un peu le français.","프랑스어를 조금 이해해요."],["Je comprends ce que tu veux dire.","무슨 뜻인지 이해해요."],["Je ne comprends pas ce mot.","이 단어를 이해하지 못하겠어요."]]},{"word":"je ne sais pas","ipa":"/ʒə nə sɛ pa/","meaning":"모르겠어요","nuance":"모른다고 자연스럽게 답할 때 씁니다.","examples":[["Je ne sais pas où il est.","그가 어디 있는지 모르겠어요."],["Je ne sais pas encore.","아직 모르겠어요."],["Je ne sais pas quoi choisir.","무엇을 골라야 할지 모르겠어요."],["Désolé, je ne sais pas.","미안하지만 모르겠어요."]]},{"word":"être","ipa":"/ɛtʁ/","meaning":"~이다, 있다","nuance":"프랑스어의 핵심 불규칙 동사입니다.","examples":[["Je veux être prêt à huit heures.","저는 8시까지 준비되어 있고 싶어요."],["Nous allons être en retard.","우리 늦을 것 같아요."],["Il faut être prudent.","조심해야 해요."],["Elle aime être seule parfois.","그녀는 가끔 혼자 있는 것을 좋아해요."]]},{"word":"avoir","ipa":"/a.vwaʁ/","meaning":"가지다, 있다","nuance":"소유·나이·상태 표현에 매우 자주 쓰입니다.","examples":[["J'ai deux frères.","저는 남자 형제가 둘 있어요."],["Nous avons une réservation.","저희는 예약이 있어요."],["Elle a vingt ans.","그녀는 스무 살이에요."],["J'ai besoin de temps.","저는 시간이 필요해요."]]},{"word":"aller","ipa":"/a.le/","meaning":"가다","nuance":"이동과 가까운 미래 표현에 자주 쓰입니다.","examples":[["Je vais au travail.","저는 일하러 가요."],["Nous allons à Paris demain.","우리는 내일 파리에 가요."],["Tu vas bien ?","잘 지내요?"],["Je vais acheter du pain.","빵을 사러 갈 거예요."]]},{"word":"venir","ipa":"/və.niʁ/","meaning":"오다","nuance":"화자 쪽으로 이동하거나 출신을 말할 때 씁니다.","examples":[["Tu viens ce soir ?","오늘 저녁에 와요?"],["Je viens de Corée.","저는 한국에서 왔어요."],["Elle vient avec nous.","그녀는 우리와 함께 와요."],["Nous venons demain matin.","우리는 내일 아침에 와요."]]}]