[{"word":"要","pinyin":"yào","meaning":"원하다, 필요하다, ~할 것이다","nuance":"의지·필요·예정 등을 나타내는 활용도가 높은 동사입니다.","examples":[["我要一杯咖啡。","커피 한 잔 주세요."],["明天我要工作。","내일 저는 일해야 해요."],["你要这个吗？","이거 필요해요?"],["快要下雨了。","곧 비가 올 것 같아요."]]},{"word":"能","pinyin":"néng","meaning":"~할 수 있다","nuance":"능력·가능성·상황상 가능 여부를 말할 때 씁니다.","examples":[["你能帮我吗？","저를 도와줄 수 있어요?"],["今天我不能去。","오늘 저는 갈 수 없어요."],["这里能拍照吗？","여기서 사진 찍어도 돼요?"],["你能听见吗？","들려요?"]]},{"word":"可以","pinyin":"kě yǐ","meaning":"~해도 된다, 가능하다","nuance":"허가나 가능을 나타낼 때 매우 자주 씁니다.","examples":[["我可以进去吗？","들어가도 돼요?"],["这里可以坐。","여기 앉아도 돼요."],["你可以慢慢说。","천천히 말해도 돼요."],["这个周末可以见面。","이번 주말에 만날 수 있어요."]]},{"word":"会","pinyin":"huì","meaning":"~할 줄 알다, ~할 것이다","nuance":"배워서 할 줄 아는 능력이나 미래 가능성을 나타냅니다.","examples":[["我会说一点中文。","저는 중국어를 조금 할 줄 알아요."],["你会开车吗？","운전할 줄 알아요?"],["明天会下雨。","내일 비가 올 거예요."],["她很快就会回来。","그녀는 곧 돌아올 거예요."]]},{"word":"知道","pinyin":"zhī dào","meaning":"알다","nuance":"사실·정보를 알고 있을 때 씁니다.","examples":[["我不知道。","저는 몰라요."],["你知道他的名字吗？","그의 이름을 알아요?"],["我知道怎么做。","어떻게 하는지 알아요."],["大家都知道这件事。","모두 이 일을 알고 있어요."]]},{"word":"觉得","pinyin":"jué de","meaning":"~라고 느끼다, 생각하다","nuance":"개인적인 의견이나 느낌을 표현할 때 매우 유용합니다.","examples":[["我觉得很好。","저는 아주 좋다고 생각해요."],["你觉得怎么样？","어떻게 생각해요?"],["我觉得今天有点冷。","오늘 조금 춥다고 느껴요."],["她觉得这个办法不错。","그녀는 이 방법이 괜찮다고 생각해요."]]},{"word":"认识","pinyin":"rèn shi","meaning":"알다, 알게 되다","nuance":"사람이나 사물과 친숙하거나 알고 있다는 뜻입니다.","examples":[["很高兴认识你。","만나서 반가워요."],["你认识他吗？","그를 알아요?"],["我不认识这个字。","저는 이 글자를 몰라요."],["我们去年认识的。","우리는 작년에 알게 됐어요."]]},{"word":"需要","pinyin":"xū yào","meaning":"필요하다","nuance":"무언가가 필요하거나 요구될 때 씁니다.","examples":[["我需要帮助。","도움이 필요해요."],["这个工作需要时间。","이 일은 시간이 필요해요."],["你需要什么？","무엇이 필요해요?"],["我们需要再确认一下。","우리는 다시 한번 확인할 필요가 있어요."]]},{"word":"帮助","pinyin":"bāng zhù","meaning":"돕다, 도움","nuance":"누군가를 돕거나 도움 자체를 뜻합니다.","examples":[["谢谢你的帮助。","도와줘서 고마워요."],["我可以帮助你。","제가 도와드릴 수 있어요."],["他经常帮助别人。","그는 자주 다른 사람을 도와요."],["这个信息对我很有帮助。","이 정보는 저에게 큰 도움이 돼요."]]},{"word":"等","pinyin":"děng","meaning":"기다리다","nuance":"사람이나 시간을 기다릴 때 씁니다.","examples":[["请等一下。","잠시 기다려 주세요."],["我在等朋友。","저는 친구를 기다리고 있어요."],["你等了多久？","얼마나 기다렸어요?"],["别等我，先走吧。","저 기다리지 말고 먼저 가세요."]]},{"word":"吃","pinyin":"chī","meaning":"먹다","nuance":"음식을 먹는 동작입니다.","examples":[["你吃饭了吗？","밥 먹었어요?"],["我想吃面条。","국수 먹고 싶어요."],["我们一起吃晚饭吧。","우리 같이 저녁 먹어요."],["她不吃辣的。","그녀는 매운 것을 먹지 않아요."]]},{"word":"喝","pinyin":"hē","meaning":"마시다","nuance":"음료를 마실 때 씁니다.","examples":[["我想喝水。","물 마시고 싶어요."],["你喝咖啡吗？","커피 마셔요?"],["多喝一点水。","물을 좀 더 마셔요."],["晚上我不喝咖啡。","저녁에는 커피를 마시지 않아요."]]},{"word":"买","pinyin":"mǎi","meaning":"사다","nuance":"물건이나 서비스를 구매할 때 씁니다.","examples":[["我想买这个。","이거 사고 싶어요."],["你在哪里买的？","어디서 샀어요?"],["我昨天买了一本书。","어제 책 한 권을 샀어요."],["这个可以买到吗？","이거 살 수 있나요?"]]},{"word":"卖","pinyin":"mài","meaning":"팔다","nuance":"물건이나 서비스를 판매할 때 씁니다.","examples":[["这里卖咖啡吗？","여기 커피 팔아요?"],["这家店卖水果。","이 가게는 과일을 팔아요."],["他们在网上卖衣服。","그들은 온라인에서 옷을 팔아요."],["这个已经不卖了。","이건 이제 판매하지 않아요."]]},{"word":"给","pinyin":"gěi","meaning":"주다, ~에게","nuance":"무언가를 건네거나 동작의 대상을 표시할 때 씁니다.","examples":[["请给我一杯水。","물 한 잔 주세요."],["我给你打电话。","제가 전화할게요."],["这是朋友给我的。","이건 친구가 저에게 준 거예요."],["请给我一点时间。","시간을 조금 주세요."]]},{"word":"找","pinyin":"zhǎo","meaning":"찾다","nuance":"사람·물건·장소 등을 찾을 때 씁니다.","examples":[["我在找钥匙。","열쇠를 찾고 있어요."],["你找谁？","누구를 찾으세요?"],["我们找个地方坐吧。","앉을 곳을 찾아봐요."],["我找不到我的手机。","휴대폰을 못 찾겠어요."]]},{"word":"开","pinyin":"kāi","meaning":"열다, 켜다, 운전하다","nuance":"문을 열거나 기계를 켜는 등 여러 뜻으로 쓰입니다.","examples":[["请开门。","문을 열어 주세요."],["可以开窗吗？","창문 열어도 돼요?"],["他会开车。","그는 운전할 줄 알아요."],["商店九点开门。","가게는 9시에 문을 열어요."]]},{"word":"关","pinyin":"guān","meaning":"닫다, 끄다","nuance":"문을 닫거나 전기기기를 끌 때 씁니다.","examples":[["请关门。","문을 닫아 주세요."],["别忘了关灯。","불 끄는 걸 잊지 마세요."],["商店十点关门。","가게는 10시에 문을 닫아요."],["请把电脑关了。","컴퓨터를 꺼 주세요."]]},{"word":"坐","pinyin":"zuò","meaning":"앉다, 타다","nuance":"앉거나 교통수단을 이용할 때 씁니다.","examples":[["请坐。","앉으세요."],["我坐地铁去公司。","저는 지하철을 타고 회사에 가요."],["你坐这里吧。","여기 앉으세요."],["我们坐出租车去。","우리 택시 타고 가요."]]},{"word":"走","pinyin":"zǒu","meaning":"걷다, 떠나다","nuance":"걸어가거나 자리를 떠날 때 씁니다.","examples":[["我们走吧。","우리 가요."],["我每天走路上班。","저는 매일 걸어서 출근해요."],["他刚刚走了。","그는 방금 갔어요."],["从这里一直往前走。","여기서 계속 앞으로 가세요."]]}]